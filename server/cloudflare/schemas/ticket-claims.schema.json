{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherloom.invalid/schemas/ticket-claims.schema.json",
  "title": "Aetherloom signed ticket claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "iss", "aud", "purpose", "sub", "iat", "nbf", "exp", "nonce"],
  "properties": {
    "v": { "const": 1 },
    "iss": { "$ref": "#/$defs/id" },
    "aud": { "$ref": "#/$defs/id" },
    "purpose": { "enum": ["session", "join", "service", "result"] },
    "sub": { "$ref": "#/$defs/id" },
    "iat": { "type": "integer", "minimum": 0 },
    "nbf": { "type": "integer", "minimum": 0 },
    "exp": { "type": "integer", "minimum": 0 },
    "nonce": { "$ref": "#/$defs/id" },
    "scopes": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "platform": { "enum": ["web", "native", "console"] },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party_id", "members", "input_pool"],
      "properties": {
        "party_id": { "$ref": "#/$defs/id" },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "input_pool": {
          "enum": ["browser", "mouse-keyboard", "controller", "mixed"]
        }
      }
    },
    "match_id": { "$ref": "#/$defs/id" },
    "region": { "$ref": "#/$defs/id" },
    "build_hash": { "$ref": "#/$defs/id" },
    "input_pool": { "enum": ["browser", "mouse-keyboard", "controller", "mixed"] },
    "player_slot": { "type": "integer", "minimum": 0, "maximum": 127 },
    "team_id": { "type": "integer", "minimum": 0, "maximum": 127 },
    "settlement_id": { "$ref": "#/$defs/id" },
    "result_hash": { "$ref": "#/$defs/id" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "purpose": { "const": "join" } },
        "required": ["purpose"]
      },
      "then": {
        "required": [
          "match_id",
          "build_hash",
          "input_pool",
          "player_slot",
          "team_id"
        ]
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    }
  }
}
