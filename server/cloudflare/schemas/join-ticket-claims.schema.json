{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aetherloom.invalid/schemas/join-ticket-claims.schema.json",
  "title": "Aetherloom Ed25519 join-ticket claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "aud",
    "purpose",
    "sub",
    "iat",
    "nbf",
    "exp",
    "nonce",
    "match_id",
    "match_epoch",
    "region",
    "build_hash",
    "input_pool",
    "player_slot",
    "team_id"
  ],
  "properties": {
    "v": { "const": 1 },
    "iss": { "$ref": "#/$defs/id" },
    "aud": { "$ref": "#/$defs/id" },
    "purpose": { "const": "join" },
    "sub": { "$ref": "#/$defs/hex128" },
    "iat": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nbf": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "exp": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nonce": { "$ref": "#/$defs/hex128" },
    "match_id": { "$ref": "#/$defs/hex128" },
    "match_epoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "region": { "$ref": "#/$defs/id" },
    "build_hash": { "$ref": "#/$defs/hex128" },
    "input_pool": {
      "enum": ["browser", "mouse-keyboard", "controller", "mixed"]
    },
    "player_slot": { "type": "integer", "minimum": 0, "maximum": 127 },
    "team_id": { "type": "integer", "minimum": 0, "maximum": 127 }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "hex128": {
      "type": "string",
      "pattern": "^(?!00000000000000000000000000000000$)[0-9a-f]{32}$"
    }
  }
}
