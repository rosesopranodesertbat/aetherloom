{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "aetherloom-control-plane-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-27",
  "workers_dev": true,
  "minify": true,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "TICKET_ISSUER": "aetherloom-control-plane",
    "PLAYER_TICKET_AUDIENCE": "aetherloom-player",
    "JOIN_TICKET_AUDIENCE": "aetherloom-match",
    "SERVICE_TICKET_AUDIENCE": "aetherloom-services",
    "RESULT_TICKET_AUDIENCE": "aetherloom-results",
    "RESULT_TICKET_HOSTS_JSON": "{\"staging-result-2026-07\":\"staging-match-host\"}",
    "JOIN_TICKET_PUBLIC_KEYS_JSON": "{\"staging-join-2026-07\":\"WmfoT0zLzJQ7W8UC52WmKC-R0SynHmU0FeKOAFpk87g\"}",
    "ACTIVE_JOIN_TICKET_KID": "staging-join-2026-07",
    "ACTIVE_SERVICE_TICKET_KID": "staging-service-2026-07",
    "CONTENT_BUILD_HASH": "abdc743597a10be51ad5344f01c89462",
    "ALLOWED_ORIGINS_JSON": "[\"https://aetherloom-staging.pages.dev\",\"https://staging.aetherloom-staging.pages.dev\"]",
    "MATCHMAKING_SHARD_COUNT": "16",
    "MATCHMAKING_SKILL_BUCKET_WIDTH": "200",
    "MAX_ISLAND_CHECKPOINT_BYTES": "8388608"
  },
  "secrets": {
    "required": [
      "PLAYER_TICKET_KEYS_JSON",
      "JOIN_TICKET_SIGNING_KEYS_JSON",
      "SERVICE_TICKET_KEYS_JSON",
      "RESULT_TICKET_KEYS_JSON"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROFILE_ISLAND",
        "class_name": "ProfileIslandObject"
      },
      {
        "name": "MATCHMAKING_SHARD",
        "class_name": "MatchmakingShardObject"
      }
    ]
  },
  "exports": {
    "ProfileIslandObject": {
      "type": "durable-object",
      "storage": "sqlite"
    },
    "MatchmakingShardObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "aetherloom-control-staging",
      "database_id": "220c38b2-1286-4a35-8c47-a7a24b83f387",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MATCH_ARCHIVE",
      "bucket_name": "aetherloom-match-archive-staging"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SETTLEMENT_QUEUE",
        "queue": "aetherloom-settlement-staging"
      }
    ],
    "consumers": [
      {
        "queue": "aetherloom-settlement-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 10,
        "dead_letter_queue": "aetherloom-settlement-staging-dlq",
        "max_concurrency": 4
      }
    ]
  }
}
